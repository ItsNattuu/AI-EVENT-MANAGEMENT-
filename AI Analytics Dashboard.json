    {
      "parameters": {
        "jsCode": "const rows = $input.all();\n\nconst totalRegistrations = rows.length;\n\nlet confirmed = 0;\nlet present = 0;\n\nconst departmentCount = {};\n\nfor (const item of rows) {\n\n  const data = item.json;\n\n  // Count confirmed registrations\n  if (data[\"Registration Status\"] === \"Confirmed\") {\n    confirmed++;\n  }\n\n  // Count attendees\n  if (data[\"Attendance\"] === \"Present\") {\n    present++;\n  }\n\n  // Count departments\n  const dept = data[\"Department\"] || \"Unknown\";\n\n  if (!departmentCount[dept]) {\n    departmentCount[dept] = 0;\n  }\n\n  departmentCount[dept]++;\n}\n\nconst attendanceRate =\n  confirmed > 0\n    ? ((present / confirmed) * 100).toFixed(2)\n    : \"0\";\n\nreturn [{\n  json: {\n    totalRegistrations,\n    confirmed,\n    present,\n    attendanceRate,\n    departmentCount\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
